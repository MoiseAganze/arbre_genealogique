{
  "name": "arbre-famille",
  "private": true,
  "description": "Arbre généalogique familial interactif (PHP, MySQL, Tailwind CSS)",
  "scripts": {
    "build": "tailwindcss -i ./src/css/input.css -o ./assets/css/app.css --minify",
    "watch": "tailwindcss -i ./src/css/input.css -o ./assets/css/app.css --watch",
    "zip": "npm run build && python3 tools/build_cpanel_zip.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
